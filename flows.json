  {
    "id": "fn-Dashboard",
    "type": "function",
    "z": "api",
    "name": "Dashboard",
    "func": "const city=global.get('city');(async()=>{try{const value=await (city.snapshot(msg.req.query||{}));msg.statusCode=200;msg.headers={'Content-Type':'application/json','Cache-Control':'no-store'};msg.payload=value;}catch(e){msg.statusCode=400;msg.headers={'Content-Type':'application/json','Cache-Control':'no-store'};msg.payload={error:e.message};}node.send(msg);node.done();})();return;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 590,
    "y": 100,
    "wires": [
