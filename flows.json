[
  {
    "id": "collect",
    "type": "tab",
    "label": "1 · Automatic data collection",
    "disabled": false,
    "info": "Real DATA.GOV.HK streams. Trigger → core HTTP request → validate / transform / MongoDB upsert. Timers run on the Node-RED server even when no dashboard is open."
  },
  {
    "id": "api",
    "type": "tab",
    "label": "2 · Dashboard API",
    "disabled": false,
    "info": "The static dashboard at / queries these HTTP endpoints. The editor is at /red/. The service in /opt/commute/lib provides tested validation, MongoDB storage, joins and descriptive statistics."
  },
  {
    "id": "init",
    "type": "inject",
    "z": "collect",
    "name": "Initialize / refresh locations · daily",
    "props": [
      {
        "p": "payload"
      },
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "repeat": "86400",
    "crontab": "",
    "once": true,
    "onceDelay": 2,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 80,
    "wires": [
      [
        "metadata"
      ]
    ]
  },
  {
    "id": "metadata",
    "type": "function",
    "z": "collect",
    "name": "Load official detector + camera metadata",
    "func": "const city=global.get('city');\n(async()=>{try{msg.payload=await (city.init().then(()=>city.metadataRefresh()));node.status({fill:'green',shape:'dot',text:new Date().toLocaleTimeString('en-GB',{timeZone:'Asia/Hong_Kong'})});node.send(msg);}catch(e){node.status({fill:'red',shape:'ring',text:e.message.slice(0,60)});node.error(e.message,msg);}finally{node.done();}})();\nreturn;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 80,
    "wires": [
      [
        "log"
      ]
    ]
  },
