FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
WORKDIR /app
ENV PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
COPY requirements-analytics.txt ./
RUN pip install --no-cache-dir -r requirements-analytics.txt
COPY analysis ./analysis
EXPOSE 8000
CMD ["uvicorn", "analysis.service:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
